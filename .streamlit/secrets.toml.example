# Paste into Streamlit Cloud → App settings → Secrets (TOML format).
# Copy values from Supabase Dashboard → Settings → API Keys for the SAME project as SUPABASE_URL.
# After saving, reboot the app. Keys must start with sb_publishable_ and sb_secret_ (or legacy eyJ... JWT).

SUPABASE_URL = "https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY = "sb_publishable_your_key_here"
SUPABASE_SECRET_KEY = "sb_secret_your_key_here"
GEMINI_API_KEY = "your-gemini-key"
GEMINI_BASE_URL = "https://generativelanguage.googleapis.com/v1beta/openai/"
GEMINI_MODEL = "gemini-2.5-pro"
APP_ENV = "production"
